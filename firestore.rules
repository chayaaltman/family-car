rules_version = '2';

// Each family is one document at families/{familyCode}.
// Knowing the code is what lets you in (like a shared link), so codes are random
// and listing all families is not allowed. See README → Known limitations.
service cloud.firestore {
  match /databases/{database}/documents {
    match /families/{code} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.resource.data.keys().hasAll(['familyName', 'members', 'cars', 'bookings'])
                            && request.resource.data.members.size() > 0;
      allow delete: if false;
    }
  }
}
